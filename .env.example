# Copy to .env.local for local development. Never commit .env* files —
# .gitignore already excludes them. See src/lib/env.ts for validation.

# Canonical site URL, used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://cristianbarbosa.com

# Postgres connection string — server-only (src/server/db/pool.ts), never
# exposed to the client. Points at a local Postgres for development, a
# Supabase project's connection string in production. See docs/DATABASE.md.
DATABASE_URL=postgres://user:password@localhost:5432/cbu_dev

# Bearer token gating /api/analytics/* (private business data — visitor
# counts, leads, revenue) for non-browser callers. The Command Center
# dashboard itself uses the admin session below, not this — see
# docs/COMMAND_CENTER.md, "Analytics endpoint authorization". Unset means
# those routes return 503 (fail closed), never open, unless
# ADMIN_SESSION_SECRET is set. Generate a real random value, e.g.
# `openssl rand -hex 32`; at least 16 characters.
ANALYTICS_API_TOKEN=

# --- Admin login (Block 04 — Command Center, docs/COMMAND_CENTER.md) ---

# Hash of the single admin password, format `scrypt:<salt>:<hash>`.
# NEVER put a plaintext password here. Generate with:
#   node scripts/admin/hash-password.mjs
# Unset means /admin/login always reports "not configured" — fails
# closed, never accepts a password.
ADMIN_PASSWORD_HASH=

# Signs/verifies the admin session cookie (HMAC-SHA256). Generate with
# `openssl rand -hex 32`; at least 32 characters. Unset means /admin/*
# and /api/analytics/* both fall back to ANALYTICS_API_TOKEN-only (or
# 503 if that's unset too).
ADMIN_SESSION_SECRET=

# --- Welcome-email automation (docs/AUTOMATIONS.md) ---

# Sends the welcome email via Gmail SMTP — no domain purchase needed to
# start (unlike Resend/similar, which require a verified domain before
# they'll email anyone but you). Both optional: unset means
# sendWelcomeEmail() skips silently (logs a warning), never breaks
# /api/lead's real job of saving the lead.

# The Gmail address that sends the email.
GMAIL_USER=

# A Google "App Password" — 16 characters, NEVER your real Gmail
# password. Requires 2-Step Verification turned on first. Generate at
# https://myaccount.google.com/apppasswords (Security → 2-Step
# Verification → App passwords). See docs/AUTOMATIONS.md for the exact
# steps.
GMAIL_APP_PASSWORD=

# --- Welcome-WhatsApp automation (docs/AUTOMATIONS.md) ---
# Meta's WhatsApp Cloud API directly — no Twilio or other intermediary.

# A System User access token from developers.facebook.com (Meta Business
# Suite → your app → WhatsApp → API Setup — use a permanent token, not
# the 24h temporary one shown by default).
META_WHATSAPP_ACCESS_TOKEN=

# The Phone Number ID (not the phone number itself) from the same
# WhatsApp → API Setup page.
META_WHATSAPP_PHONE_NUMBER_ID=

# --- Reserved for future blocks (not read by the app yet) ---
# Analytics sink (once a vendor is chosen):
# NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
